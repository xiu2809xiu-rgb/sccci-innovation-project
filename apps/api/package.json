{
  "name": "@huitong/api",
  "version": "0.1.0",
  "private": true,
  "description": "HuiTong API: NestJS integration and workflow-automation backend.",
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts",
    "src/generated"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "prepare": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@huitong/shared": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.16",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@huitong/mock-cn-hq": "workspace:*",
    "@huitong/mock-oa": "workspace:*",
    "@huitong/mock-sg-hr": "workspace:*",
    "@huitong/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
