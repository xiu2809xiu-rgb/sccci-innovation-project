{
  "name": "huitong",
  "version": "0.1.0",
  "private": true,
  "description": "HuiTong 汇通: HR and administration integration and workflow-automation layer (IT2134, SCCCI x NYP AI Innovation Challenge, Problem Statement #17).",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @huitong/web test:e2e",
    "db:migrate": "pnpm --filter @huitong/api db:migrate",
    "db:seed": "pnpm --filter @huitong/api db:seed",
    "diagrams:build": "node scripts/build-diagrams.mjs",
    "diagrams:check": "node scripts/build-diagrams.mjs --check",
    "slides:build": "node scripts/build-slides.mjs",
    "slides:check": "node scripts/build-slides.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "assets:3d": "node assets-src/3d/build.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@huitong/eslint-config": "workspace:*",
    "@marp-team/marp-cli": "4.5.1",
    "@mermaid-js/mermaid-cli": "12.0.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer": "25.14.0",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": "prettier --write"
  }
}
