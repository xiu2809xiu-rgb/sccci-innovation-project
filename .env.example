# HuiTong environment variables. Every variable the stack reads is listed here.
#
# docker compose:  copy to `.env` in the repository root to override the defaults below.
# Local API dev:   copy the API section to `apps/api/.env`.
# Never commit a filled-in copy: every `.env*` file except this one is git-ignored.

# --- Shared ---------------------------------------------------------------
# info | debug | warn | error | silent
LOG_LEVEL=info

# --- PostgreSQL (docker compose) -----------------------------------------
# Local development only; production reads the password from AWS Secrets Manager.
POSTGRES_PASSWORD=huitong_local_only
POSTGRES_PORT=5432

# --- Redis (docker compose) ----------------------------------------------
REDIS_PORT=6379

# --- API -----------------------------------------------------------------
PORT=3000
DATABASE_URL=postgresql://huitong:huitong_local_only@localhost:5432/huitong
REDIS_URL=redis://localhost:6379

# --- Web (Vite dev server) -----------------------------------------------
# Where `pnpm dev` proxies /api and /health to.
VITE_API_PROXY_TARGET=http://localhost:3000

# --- React Bits licence (apps/web/.env.local only, never here) -----------
# The shadcn CLI reads REACTBITS_LICENSE_KEY from apps/web/.env.local when
# installing React Bits Pro items. Ask the team lead for the key; do not share it.
# REACTBITS_LICENSE_KEY=
