# HuiTong environment variables. Every variable the stack reads is listed here.
#
# docker compose:  copy to `.env` in the repository root to override the compose defaults.
# Local API dev:   copy the shared and API sections to `apps/api/.env`.
# Never commit a filled-in copy: every `.env*` file except this one is git-ignored.

# --- Shared ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- PostgreSQL and Redis (docker compose host ports) --------------------
# Local development only; production reads credentials from AWS Secrets Manager.
POSTGRES_PASSWORD=huitong_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- API: runtime ---------------------------------------------------------
# development (pretty logs) | test | production
NODE_ENV=development
# local | demo | production. Production refuses DEMO_MODE, insecure cookies and the example JWT secret.
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://huitong:huitong_local_only@localhost:5432/huitong
REDIS_URL=redis://localhost:6379
# Comma-separated origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# true when the API sits behind nginx or a load balancer (client IPs, rate limits).
TRUST_PROXY=false
SWAGGER_ENABLED=true

# --- API: authentication -------------------------------------------------
# At least 32 random characters. This example value is rejected when APP_ENV=production.
JWT_ACCESS_SECRET=change-me-local-dev-only-32-characters-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies work on http://localhost in Chrome, Edge and Firefox. Use false only on
# other plain-HTTP hosts during local development; production requires true.
COOKIE_SECURE=true
# Enables POST /api/v1/auth/demo-login (the role switcher). Never true in production.
DEMO_MODE=true

# --- API: connectors to the mock systems ---------------------------------
SG_HR_BASE_URL=http://localhost:4101
SG_HR_API_KEY=sg-hr-local-key
CN_HQ_BASE_URL=http://localhost:4102
CN_HQ_USERNAME=huitong_rfc
CN_HQ_PASSWORD=cn-hq-local-pass
OA_BASE_URL=http://localhost:4103
OA_API_TOKEN=oa-local-token
OA_WEBHOOK_SECRET=oa-local-webhook-secret
# Loads the employee master from SG HR, then CN HQ, on start when no sync has ever run.
# docker compose turns it on; local development and tests leave it off.
BOOTSTRAP_SYNC=false

# --- API: AI ---------------------------------------------------------------
# mock (default, deterministic, no key) | bedrock | openai
LLM_PROVIDER=mock
# Required for bedrock and openai: the model id available in your account and region.
# LLM_MODEL=
BEDROCK_REGION=ap-southeast-1
# OPENAI_API_KEY=
# Reference prices for the cost estimate (USD per 1,000 tokens), not an invoice.
AI_PRICE_INPUT_PER_1K_USD=0.003
AI_PRICE_OUTPUT_PER_1K_USD=0.015

# --- API: integration tests (optional overrides) -------------------------
# TEST_DATABASE_URL=postgresql://huitong:huitong_local_only@localhost:5432/huitong_test
# TEST_REDIS_URL=redis://localhost:6379/1

# --- Mock systems ------------------------------------------------------------
# Each mock reads PORT plus its own credentials (defaults match the values above).
# OA_WEBHOOK_URL tells the OA mock where to post signed approval webhooks.
# OA_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/oa

# --- Web (Vite dev server) -----------------------------------------------
# Where `pnpm dev` proxies /api and /health to.
VITE_API_PROXY_TARGET=http://localhost:3000

# --- React Bits licence (apps/web/.env.local only, never here) -----------
# The shadcn CLI reads REACTBITS_LICENSE_KEY from apps/web/.env.local when
# installing React Bits Pro items. Ask the team lead for the key; do not share it.
# REACTBITS_LICENSE_KEY=
